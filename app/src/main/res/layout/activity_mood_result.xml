<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:cardview="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MoodResult">

    <VideoView
        android:id="@+id/videoBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_alignParentTop="true"
        android:layout_alignParentBottom="true"
        android:layout_alignParentLeft="true"
        android:layout_alignParentRight="true" />


    <TextView
        android:id="@+id/moodresult"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="50dp"
        android:text="Sad"
        android:textAlignment="center"
        android:textColor="#FFFF"
        android:textSize="40sp"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/mooddisplay"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_below="@id/moodresult"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="16dp"
        android:contentDescription="Main Mood GIF"
        android:scaleType="centerInside"
        android:src="@drawable/crying_face_1f622gif" />

    <TextView
        android:id="@+id/moodaccuracy"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/mooddisplay"
        android:layout_marginTop="16dp"
        android:text="90 %"
        android:textAlignment="center"
        android:textColor="#FFFF"
        android:textSize="30sp"
        android:textStyle="bold" />

    <androidx.cardview.widget.CardView
        android:id="@+id/cardView"
        android:layout_width="384dp"
        android:layout_height="283dp"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="16dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/custom_edittext"
        app:cardCornerRadius="30dp"
        app:cardElevation="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="155dp"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:padding="24dp">

                    <ImageView
                        android:id="@+id/mood1"
                        android:layout_width="108dp"
                        android:layout_height="110dp"
                        android:layout_marginEnd="8dp"
                        android:clickable="true"
                        android:scaleType="centerInside"
                        android:src="@drawable/crying_face_1f622" /> <!-- optional spacing between emojis -->

                    <ImageView
                        android:id="@+id/mood2"
                        android:layout_width="105dp"
                        android:layout_height="103dp"
                        android:layout_marginEnd="8dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/fearful_face_1f628" />

                    <ImageView
                        android:id="@+id/mood3"
                        android:layout_width="105dp"
                        android:layout_height="103dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/nauseated_face_1f922" />
                </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="24dp"
            android:gravity="bottom">

            <Button
                android:id="@+id/button"
                android:layout_width="match_parent"
                android:layout_height="59dp"
                android:text="Back To The Dashboard"
                android:textSize="20dp"
                android:backgroundTint="@color/navy"/>
        </LinearLayout>

    </androidx.cardview.widget.CardView>

</RelativeLayout>
